#!/usr/bin/env python3

import html
import json
import os
import re
import socket
import ssl
import subprocess

from datetime import datetime
from pathlib import Path

from urllib.parse import (
    parse_qsl,
    urlencode,
    urlsplit,
    urlunsplit,
)

from urllib.error import HTTPError
from urllib.request import urlopen


SMOKE = "/usr/local/sbin/home-smoke-test"

# T07.3: saída fora de /opt/caddy (Blue). Lida por accessgateway-status-sync,
# que copia para o diretório servido pela Green. O caminho antigo
# (/opt/caddy/config/smoke-status) não é mais escrito nem apagado.
OUT_DIR = Path("/srv/accessgateway/shared/smoke-status")
JSON_FILE = OUT_DIR / "status.json"
HTML_FILE = OUT_DIR / "index.html"

KUMA_URL_FILE = Path(
    "/etc/home-smoke-test/kuma-push-url"
)

# Raiz da CA interna do Caddy (T06.3): confiada,
# além das CAs do sistema, no push HTTPS ao Kuma.
KUMA_CA_FILE = Path(
    "/etc/homeautomation/certs/caddy-local-root.crt"
)


def kuma_tls_context():
    # Verificação completa: cadeia e hostname
    # (CERT_REQUIRED e check_hostname=True são
    # o padrão de create_default_context).
    context = ssl.create_default_context()

    if KUMA_CA_FILE.is_file():
        context.load_verify_locations(
            cafile=str(KUMA_CA_FILE)
        )

    return context


def describe_push_error(exc):
    # Classe e motivo, nunca a URL: o token do
    # push vai no caminho (/api/push/<token>).
    reason = getattr(exc, "reason", None)

    if isinstance(exc, HTTPError):
        detail = f"HTTP {exc.code}"
    elif isinstance(reason, ssl.SSLCertVerificationError):
        detail = f"TLS: {reason.verify_message}"
    elif isinstance(exc, ssl.SSLCertVerificationError):
        detail = f"TLS: {exc.verify_message}"
    elif isinstance(exc, (TimeoutError, socket.timeout)) or isinstance(reason, (TimeoutError, socket.timeout)):
        detail = "timeout"
    else:
        detail = str(reason if reason is not None else exc)

    detail = re.sub(
        r"/api/push/[^\s?'\"]+",
        "/api/push/<token>",
        detail
    )[:200]

    return f"{type(exc).__name__} ({detail})"


# Remove códigos ANSI gerados pelo smoke-test
ansi = re.compile(
    r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])"
)


#
# Executa o smoke-test
#

result = subprocess.run(
    [SMOKE],
    text=True,
    capture_output=True
)

raw = result.stdout + result.stderr
clean = ansi.sub("", raw)


#
# Extrai resultados PASS / FAIL
#

checks = []

for line in clean.splitlines():
    match = re.match(
        r"^\[(PASS|FAIL)\]\s+(.*)$",
        line.strip()
    )

    if match:
        checks.append({
            "status": match.group(1),
            "description": match.group(2)
        })


passed = sum(
    1
    for check in checks
    if check["status"] == "PASS"
)

failed = sum(
    1
    for check in checks
    if check["status"] == "FAIL"
)


#
# Estado geral
#

ok = (
    result.returncode == 0
    and failed == 0
)

generated_at = (
    datetime
    .now()
    .astimezone()
    .isoformat()
)


#
# Objeto JSON
#

data = {
    "ok": ok,
    "generatedAt": generated_at,
    "passed": passed,
    "failed": failed,
    "checks": checks
}


#
# Garante diretório de saída
#

# Somente root (publicador e sincronizador rodam como root);
# o modo só vale na criação.
OUT_DIR.mkdir(
    mode=0o750,
    parents=True,
    exist_ok=True
)


#
# Escrita atômica para evitar arquivo parcial:
# temporário no mesmo diretório, fsync e rename.
# Quem lê (accessgateway-status-sync) vê o arquivo
# antigo ou o novo, nunca um parcial.
#

def atomic_write(path, content):
    tmp = Path(
        str(path) + ".tmp"
    )

    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())

    os.chmod(tmp, 0o644)

    os.replace(
        tmp,
        path
    )


#
# Publica JSON
#

atomic_write(
    JSON_FILE,
    json.dumps(
        data,
        indent=2,
        ensure_ascii=False
    )
)


#
# Monta tabela HTML
#

rows = ""

for check in checks:
    status = check["status"]

    description = html.escape(
        check["description"]
    )

    css_class = (
        "pass"
        if status == "PASS"
        else "fail"
    )

    rows += f"""
        <tr>
            <td class="{css_class}">
                {status}
            </td>
            <td>
                {description}
            </td>
        </tr>
    """


#
# Estado geral da página
#

overall_class = (
    "pass"
    if ok
    else "fail"
)

overall_text = (
    "OK"
    if ok
    else "FALHOU"
)


#
# HTML
#

page = f"""<!doctype html>

<html lang="pt-BR">

<head>

<meta charset="utf-8">

<meta
    name="viewport"
    content="width=device-width,initial-scale=1">

<meta
    http-equiv="refresh"
    content="60">

<title>
    Home Server - Smoke Test
</title>

<style>

body {{
    font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    max-width: 900px;
    margin: 30px auto;
    padding: 0 20px;

    background: #111;
    color: #eee;
}}

h1 {{
    margin-bottom: 20px;
}}

.card {{
    background: #1c1c1c;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
}}

.pass {{
    color: #59d987;
    font-weight: 700;
}}

.fail {{
    color: #ff6868;
    font-weight: 700;
}}

table {{
    border-collapse: collapse;
    width: 100%;
}}

td {{
    padding: 8px;
    border-bottom: 1px solid #333;
}}

td:first-child {{
    width: 80px;
}}

small {{
    color: #999;
}}

.summary {{
    font-size: 18px;
}}

</style>

</head>

<body>

<h1>
    Home Server
</h1>

<div class="card">

    <h2 class="{overall_class}">
        Smoke Test: {overall_text}
    </h2>

    <p class="summary">
        PASS: {passed}
        &nbsp;&nbsp;
        FAIL: {failed}
    </p>

    <small>
        Última execução:
        {html.escape(generated_at)}
    </small>

</div>

<div class="card">

<table>

{rows}

</table>

</div>

</body>

</html>
"""


#
# Publica HTML
#

atomic_write(
    HTML_FILE,
    page
)


#
# Envia heartbeat para Uptime Kuma
#

if KUMA_URL_FILE.exists():

    try:

        push_url = (
            KUMA_URL_FILE
            .read_text(
                encoding="utf-8"
            )
            .strip()
        )

        if push_url:

            message = (
                f"{passed} PASS / "
                f"{failed} FAIL"
            )


            #
            # Divide a URL original do Kuma
            #

            parts = urlsplit(
                push_url
            )


            #
            # Carrega parâmetros já existentes.
            #
            # A URL criada pelo Kuma normalmente
            # já contém status, msg e ping.
            #

            query = dict(
                parse_qsl(
                    parts.query,
                    keep_blank_values=True
                )
            )


            #
            # SUBSTITUI status e msg existentes,
            # evitando duplicação.
            #

            query["status"] = (
                "up"
                if ok
                else "down"
            )

            query["msg"] = message


            #
            # Reconstrói a URL
            #

            request_url = urlunsplit((
                parts.scheme,
                parts.netloc,
                parts.path,
                urlencode(query),
                parts.fragment
            ))


            #
            # TLS (T06.3): URLs HTTPS são verificadas
            # (cadeia e hostname) pelas CAs do sistema
            # mais a raiz da CA interna do Caddy.
            # Nenhum outro esquema é aceito.
            #
            # Não exibimos a URL nem qualquer
            # identificador do monitor.
            #

            if parts.scheme not in ("http", "https"):
                raise ValueError(
                    f"esquema não suportado: {parts.scheme or 'vazio'}"
                )

            context = None

            if parts.scheme == "https":
                context = kuma_tls_context()


            #
            # Envia heartbeat
            #

            with urlopen(
                request_url,
                timeout=5,
                context=context
            ) as response:

                response.read()

                if response.status != 200:
                    raise RuntimeError(
                        f"HTTP {response.status}"
                    )


    except Exception as exc:

        #
        # Não mostrar URL nem credenciais.
        #

        print(
            "Aviso: não foi possível "
            "atualizar o Kuma: "
            f"{describe_push_error(exc)}"
        )


#
# Resultado local
#

print(
    "Smoke publicado: "
    f"{passed} PASS / "
    f"{failed} FAIL"
)

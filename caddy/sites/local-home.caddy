# Hosts locais *.home (reescritas explícitas no AdGuard → 192.168.0.162).
# Mesma ordem da Blue, para que o JSON adaptado seja idêntico.
# Paridade com a Blue: estes aliases não passam pelo Authelia (achado de segurança registrado no inventário).
# Exceção: kuma.home (T07.6.1, fora da paridade).

# T07.6.1: o alias só entrega o push dos monitores (home-smoke-publish usa https://kuma.home/api/push/<token>).
# Interface, Socket.IO, /metrics, badges e status pages → 301 para kuma.home.doublesilva.com (forward_auth home-admin).
kuma.home {
	tls internal

	# path_regexp casa com o caminho NORMALIZADO, mas o upstream recebe o caminho CRU: "/socket.io/../api/push/x" casaria
	# e chegaria ao engine.io do Kuma (handshake administrativo). Por isso o caminho cru também tem de ser exatamente
	# /api/push/<token>, com um charset sem ".", "%" ou "/" (tokens do Kuma são alfanuméricos).
	@push {
		method GET POST
		path_regexp ^/api/push/[A-Za-z0-9_-]+$
		expression {http.request.uri.path}.matches("^/api/push/[A-Za-z0-9_-]+$")
	}

	handle @push {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		redir https://kuma.home.doublesilva.com{uri} permanent
	}
}

frigate.home {
	tls internal

	reverse_proxy https://127.0.0.1:8971 {
		import insecure_https_upstream
	}
}

panel.home {
	tls internal

	redir https://panel.home.doublesilva.com{uri} permanent
}

adguard.home {
	tls internal

	redir https://adguard.home.doublesilva.com{uri} permanent
}

portainer.home {
	tls internal

	redir https://portainer.home.doublesilva.com{uri} permanent
}

ha.home {
	tls internal

	reverse_proxy 192.168.0.166:80
}

mediamtx.home {
	tls internal

	reverse_proxy 127.0.0.1:8889
}

netdata.home {
	tls internal

	import netdata_dashboard
}

casa.home {
	tls internal

	reverse_proxy 127.0.0.1:5300
}

# Distribuição da raiz PÚBLICA da CA interna (somente HTTP: o dispositivo ainda não confia na CA). Desde a T07.4 o
# arquivo vem de /config/public-certs (scripts/publish-public-ca.sh; montagem somente leitura), não mais do
# casa-dashboard publicado pelo HomeAutomation em /opt/caddy. Contrato preservado: mesma URL e mesmo Content-Type.
http://cert.home {
	@rootCert path /caddy-root.crt

	handle @rootCert {
		root * /config/public-certs
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
		respond "Not Found" 404
	}
}

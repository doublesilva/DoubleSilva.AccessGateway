# AccessGateway — Green (Caddy + Authelia).
#
# Os padrões são os do MODO PREPARAÇÃO: um `up` sem arquivo de ambiente nunca ocupa 80/443 nem 9091.
# Uso no servidor (scripts/deploy-green.sh):
#   docker compose --env-file /srv/accessgateway/accessgateway.env -f compose.yml up -d
#
# Montagens com create_host_path=false: um diretório ausente faz o `up` falhar em vez de criar um diretório vazio.
# Nenhum caminho da Blue nem de outros projetos é montado (T07.4); tudo vem de /srv/accessgateway.

name: accessgateway

x-bind: &bind
  type: bind
  bind:
    create_host_path: false

services:
  caddy:
    image: caddy@sha256:14a9c00d4e833ebc2b65d36515b37bde3b73f0b323a2663aaafc88953d8c4e3f # 2.11.4, a mesma da Blue
    container_name: accessgateway-caddy
    network_mode: host
    restart: unless-stopped
    command: ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
    environment:
      GATEWAY_ADMIN_PORT: ${GATEWAY_ADMIN_PORT:-2020}
      GATEWAY_HTTP_PORT: ${GATEWAY_HTTP_PORT:-18080}
      GATEWAY_HTTPS_PORT: ${GATEWAY_HTTPS_PORT:-18443}
      # Vazio somente no cutover (todas as interfaces); sem variável definida, fica restrito ao loopback.
      GATEWAY_DEFAULT_BIND: ${GATEWAY_DEFAULT_BIND-default_bind 127.0.0.1}
      GATEWAY_AUTHELIA_UPSTREAM: 127.0.0.1:${AUTHELIA_HOST_PORT:-19091}
    volumes:
      - <<: *bind
        source: ./caddy
        target: /etc/caddy
        read_only: true
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/caddy
        target: /data
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/caddy-config
        target: /config
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/static/netdata-dashboard
        target: /config/netdata-dashboard
        read_only: true
      # Raiz PÚBLICA da CA para http://cert.home/caddy-root.crt (T07.4), publicada por scripts/publish-public-ca.sh.
      # Substitui a montagem de /opt/caddy/config/casa-dashboard (Blue/HomeAutomation): nenhum caminho de outro projeto.
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/shared/public-certs
        target: /config/public-certs
        read_only: true
    depends_on:
      authelia:
        condition: service_healthy

  authelia:
    image: authelia/authelia@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54 # 4.39.28, a mesma da Blue
    container_name: accessgateway-authelia
    restart: unless-stopped
    ports:
      - "127.0.0.1:${AUTHELIA_HOST_PORT:-19091}:9091"
    environment:
      TZ: America/Sao_Paulo
      X_AUTHELIA_CONFIG: /config/configuration.yml
      X_AUTHELIA_CONFIG_FILTERS: template
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE: /secrets/JWT_SECRET
      AUTHELIA_SESSION_SECRET_FILE: /secrets/SESSION_SECRET
      AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE: /secrets/STORAGE_ENCRYPTION_KEY
    volumes:
      - <<: *bind
        source: ./authelia/configuration.yml
        target: /config/configuration.yml
        read_only: true
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/secrets/authelia
        target: /secrets
        read_only: true
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/authelia
        target: /data

  # LLDAP (T09.3.6): preparado, mas fora do deploy normal. Só sobe com `--profile lldap`; o Authelia ainda usa o
  # backend file. Sem portas publicadas (LDAP 3890 e HTTP 17170 só na rede do compose). Antes do primeiro `up`:
  # scripts/lldap-provision.sh (diretórios e segredos). Backup consistente: scripts/lldap-backup.sh.
  lldap:
    image: lldap/lldap@sha256:2a8454b668c1aba7157e832eab0e242e1e7eb5fb7591d7e7774ba05286511ca8 # 0.6.3, homologada na T09.3.4/T09.3.5
    container_name: accessgateway-lldap
    profiles: ["lldap"]
    restart: unless-stopped
    command: ["run", "--config-file", "/config/lldap_config.toml"]
    environment:
      TZ: America/Sao_Paulo
      # Lidos pelo processo do LLDAP (uid 1000): arquivos com dono 1000:1000 e modo 400.
      LLDAP_KEY_SEED_FILE: /secrets/KEY_SEED
      LLDAP_JWT_SECRET_FILE: /secrets/JWT_SECRET
      LLDAP_LDAP_USER_PASS_FILE: /secrets/ADMIN_PASSWORD
    # O entrypoint da imagem faz chown de /app e /data e troca para o uid 1000 (gosu): por isso não há read_only e
    # ficam só as capabilities necessárias para isso.
    cap_drop: [ALL]
    cap_add: [CHOWN, SETUID, SETGID, DAC_OVERRIDE, FOWNER]
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      # Verifica LDAP e GraphQL do próprio servidor (T09.3.5: detecta LLDAP parado e congelado).
      test: ["CMD", "/app/lldap", "healthcheck", "--config-file", "/config/lldap_config.toml"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - <<: *bind
        source: ./lldap/lldap_config.toml
        target: /config/lldap_config.toml
        read_only: true
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/secrets/lldap
        target: /secrets
        read_only: true
      - <<: *bind
        source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/lldap
        target: /data

--- a/compose.yml
+++ b/compose.yml
@@ -78,3 +78,43 @@
       - <<: *bind
         source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/authelia
         target: /data
+
+  # LLDAP (T09.3.6): preparado, mas fora do deploy normal. Só sobe com `--profile lldap`; o Authelia ainda usa o
+  # backend file. Sem portas publicadas (LDAP 3890 e HTTP 17170 só na rede do compose). Antes do primeiro `up`:
+  # scripts/lldap-provision.sh (diretórios e segredos). Backup consistente: scripts/lldap-backup.sh.
+  lldap:
+    image: lldap/lldap@sha256:2a8454b668c1aba7157e832eab0e242e1e7eb5fb7591d7e7774ba05286511ca8 # 0.6.3, homologada na T09.3.4/T09.3.5
+    container_name: accessgateway-lldap
+    profiles: ["lldap"]
+    restart: unless-stopped
+    command: ["run", "--config-file", "/config/lldap_config.toml"]
+    environment:
+      TZ: America/Sao_Paulo
+      # Lidos pelo processo do LLDAP (uid 1000): arquivos com dono 1000:1000 e modo 400.
+      LLDAP_KEY_SEED_FILE: /secrets/KEY_SEED
+      LLDAP_JWT_SECRET_FILE: /secrets/JWT_SECRET
+      LLDAP_LDAP_USER_PASS_FILE: /secrets/ADMIN_PASSWORD
+    # O entrypoint da imagem faz chown de /app e /data e troca para o uid 1000 (gosu): por isso não há read_only e
+    # ficam só as capabilities necessárias para isso.
+    cap_drop: [ALL]
+    cap_add: [CHOWN, SETUID, SETGID, DAC_OVERRIDE, FOWNER]
+    security_opt: ["no-new-privileges:true"]
+    healthcheck:
+      # Verifica LDAP e GraphQL do próprio servidor (T09.3.5: detecta LLDAP parado e congelado).
+      test: ["CMD", "/app/lldap", "healthcheck", "--config-file", "/config/lldap_config.toml"]
+      interval: 10s
+      timeout: 5s
+      retries: 3
+      start_period: 30s
+    volumes:
+      - <<: *bind
+        source: ./lldap/lldap_config.toml
+        target: /config/lldap_config.toml
+        read_only: true
+      - <<: *bind
+        source: ${GATEWAY_ROOT:-/srv/accessgateway}/secrets/lldap
+        target: /secrets
+        read_only: true
+      - <<: *bind
+        source: ${GATEWAY_ROOT:-/srv/accessgateway}/data/lldap
+        target: /data

#!/usr/bin/env bash
# Stub de docker para os testes de cutover/rollback. Estado em $STUB_STATE:
#   running/<container>    container em execução
#   green_port             GATEWAY_HTTPS_PORT com que o Caddy da Green foi iniciado
# Toda chamada é registrada em $STUB_STATE/calls.log. Falhas simuladas: FAIL_AUTHELIA=1.
S=${STUB_STATE:?}
mkdir -p "$S/running"
echo "docker $*" >> "$S/calls.log"
run() { [ -e "$S/running/$1" ]; }
port443_busy() { run caddy || { run accessgateway-caddy && [ "$(cat "$S/green_port" 2>/dev/null)" = 443 ]; }; }

case "$1" in
  inspect)
    name=""; for a in "$@"; do case "$a" in inspect|--format|*'{{'*) ;; *) name=$a ;; esac; done
    if [[ "$*" == *".State.Running"* ]]; then
      [ -e "$S/known/$name" ] || [ -e "$S/running/$name" ] || exit 1
      run "$name" && echo true || echo false
    elif [[ "$*" == *".Config.Env"* ]]; then
      [ "$name" = accessgateway-caddy ] && echo "GATEWAY_HTTPS_PORT=$(cat "$S/green_port" 2>/dev/null)"
    fi
    ;;
  ps) ls "$S/running" ;;
  stop) rm -f "$S/running/$2"; echo "$2" ;;
  compose)
    shift
    if [ "$1" = -f ] && [ "$2" = /opt/caddy/compose.yml ]; then
      case "$3" in
        stop) rm -f "$S/running/caddy" ;;
        start) port443_busy && { echo "bind: address already in use" >&2; exit 1; }; touch "$S/running/caddy" ;;
        *) exit 1 ;;
      esac
      exit 0
    fi
    envfile=""; args=()
    while [ $# -gt 0 ]; do
      case "$1" in --env-file) envfile=$2; shift 2 ;; --project-directory|-f) shift 2 ;; *) args+=("$1"); shift ;; esac
    done
    case "${args[0]}" in
      config) exit 0 ;;
      stop|down) rm -f "$S/running/accessgateway-caddy" "$S/running/accessgateway-authelia" ;;
      up)
        svc="${args[-1]}"
        port=$(sed -n 's/^GATEWAY_HTTPS_PORT=//p' "$envfile")
        if [ "$svc" = authelia ]; then
          [ "${FAIL_AUTHELIA:-0}" = 1 ] && exit 1
          touch "$S/running/accessgateway-authelia"
        elif [ "$svc" = caddy ]; then
          sleep "${STUB_SLOW_GREEN_UP:-0}"
          [ "$port" = 443 ] && run caddy && { echo "bind: address already in use" >&2; exit 1; }
          touch "$S/running/accessgateway-caddy"; echo "$port" > "$S/green_port"
        else
          touch "$S/running/accessgateway-authelia" "$S/running/accessgateway-caddy"; echo "$port" > "$S/green_port"
        fi
        ;;
    esac
    ;;
esac
exit 0

# Ambiente da Green em MODO PRODUÇÃO — somente no cutover (T04), com aprovação explícita.
# deploy-green.sh recusa este modo; ele existe aqui para que o compose seja validado nos dois modos.
GATEWAY_MODE=cutover
GATEWAY_ROOT=/srv/accessgateway
GATEWAY_ADMIN_PORT=2020
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
GATEWAY_DEFAULT_BIND=
AUTHELIA_HOST_PORT=19091
CASA_DASHBOARD_DIR=/opt/caddy/config/casa-dashboard

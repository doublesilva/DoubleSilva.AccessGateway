# Ambiente da Green em MODO PREPARAÇÃO (T03).
# No servidor: /srv/accessgateway/accessgateway.env (root:root 600). Não contém segredos.
GATEWAY_MODE=prep
GATEWAY_ROOT=/srv/accessgateway
GATEWAY_ADMIN_PORT=2020
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18443
GATEWAY_DEFAULT_BIND="default_bind 127.0.0.1"
AUTHELIA_HOST_PORT=19091

# Backend de usuários do Authelia (T09.3.8): file (padrão) ou ldap. Muda SOMENTE por scripts/authelia-backend.sh,
# com o LLDAP saudável e a migração verificada. Em ldap, todo `compose_green up` passa pelo pré-flight do LLDAP.
# GATEWAY_AUTH_BACKEND=file
